rules_version = '2';

// The app doesn't store any data yet, so everything is denied.
// When the first feature needs to save data, add owner-only rules for it
// (e.g. users/{uid}/stages/{stage}/...) with tests, following the playbook's
// firebase-auth-and-firestore.md (test-app's firestore.rules is the example).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
